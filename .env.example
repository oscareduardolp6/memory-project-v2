# Copia este archivo a .env.local y llena los valores de tu Web App de Firebase.
# Sin estos valores la app funciona completa, solo que sin login ni progreso.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Tu UID de Firebase Auth (se muestra en el menú del avatar si está vacío).
VITE_OWNER_UID=
